# Ontology Viewer backend configuration.
# Copy to .env (backend working directory) or export in the environment.
# All variables use the ONTOVIEW_ prefix. List values are JSON arrays.

# Environment name: development | production
ONTOVIEW_ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
ONTOVIEW_LOG_LEVEL=INFO

# Directory for workspace metadata and original files (absolute path recommended)
ONTOVIEW_DATA_DIR=./data

# Comma-free JSON array of allowed browser origins for CORS
ONTOVIEW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Maximum bytes accepted for a single uploaded file
ONTOVIEW_MAX_UPLOAD_BYTES=52428800

# Maximum total bytes across all sources in one workspace
ONTOVIEW_MAX_WORKSPACE_BYTES=524288000

# Maximum number of sources per workspace
ONTOVIEW_MAX_SOURCE_COUNT=100

# Maximum import resolution depth (hops from the imported source)
ONTOVIEW_MAX_IMPORT_DEPTH=5

# Maximum number of sources added through import resolution
ONTOVIEW_MAX_IMPORTED_SOURCES=50

# Maximum nodes returned by a graph query
ONTOVIEW_MAX_GRAPH_NODES=20000

# Maximum edges returned by a graph query
ONTOVIEW_MAX_GRAPH_EDGES=100000

# Evidence entries embedded per graph node/edge (full list via entity endpoint)
ONTOVIEW_MAX_EVIDENCE_PER_ELEMENT=20

# Projection cache entry count
ONTOVIEW_PROJECTION_CACHE_SIZE=32

# Enable network import resolution (keep false unless you reviewed the policy)
ONTOVIEW_NETWORK_IMPORTS_ENABLED=false

# JSON array of hosts permitted for network imports when enabled
ONTOVIEW_NETWORK_HOST_ALLOWLIST=[]

# Network request timeout in seconds
ONTOVIEW_NETWORK_TIMEOUT_SECONDS=15

# Maximum bytes downloaded per network import
ONTOVIEW_NETWORK_MAX_BYTES=52428800

# JSON array of XML catalog file paths used for IRI-to-file mapping
ONTOVIEW_XML_CATALOG_PATHS=[]

# JSON array of directories searched when resolving local imports
ONTOVIEW_LOCAL_IMPORT_ROOTS=[]

# JSON array of preferred label languages (e.g. en, de)
ONTOVIEW_PREFERRED_LABEL_LANGUAGES=["en"]
